rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 📷 사진·탁본 업로드 (브라우저에서 리사이즈한 이미지를 base64로 저장)
    match /photos/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name','caption','image','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 200
        && request.resource.data.image is string
        && request.resource.data.image.size() > 100
        && request.resource.data.image.size() < 900000
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.token.email == 'nextjava@naver.com';
    }

    // 💬 피드백 게시판
    match /feedback/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name','message','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.token.email == 'nextjava@naver.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
